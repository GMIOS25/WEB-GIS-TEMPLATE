# Copy sang .env (KHÔNG commit .env thật) rồi điền giá trị thật:
#   cp .env.example .env
#
# Đây là file .env cho docker-compose.yml (production/VPS). Khác với
# BE/src/main/resources/application.properties.example - file đó dùng cho chạy BE
# trực tiếp bằng ./mvnw (local dev, không qua Docker). Xem
# docs/en/DEPLOYMENT & FLEET STRATEGY.md Section 4.3.

# --- Database credentials ---
POSTGRES_DB=gialai
POSTGRES_USER=gis_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Spring datasource (Spring Boot relaxed-binding maps các biến này thẳng vào
#     spring.datasource.* - không cần file application.properties trong container) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/gialai
SPRING_DATASOURCE_USERNAME=gis_admin
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- JWT ---
# Sinh bằng: openssl rand -hex 32  (>= 32 byte / 256 bit - JwtTokenProvider sẽ
# fail-fast lúc khởi động nếu ngắn hơn, xem JwtTokenProvider#init)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRATION_MS=86400000
# Giữ true ở production (bắt buộc chạy qua HTTPS - Caddy đã lo phần này).
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=Strict

# --- Reverse proxy (Caddy) ---
# BẮT BUỘC ở production: nếu thiếu, HttpServletRequest#getRemoteAddr() sẽ luôn trả về
# IP của container Caddy cho mọi request (vì Caddy là process duy nhất gọi thẳng app -
# "no published port on the host"), khiến LoginAttemptService (rate-limit đăng nhập
# theo IP) gộp nhầm toàn bộ người dùng vào chung 1 "IP". Xem comment trong
# BE/src/main/resources/application.properties.example.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# --- JPA ---
# false: tắt Open Session In View (Spring Boot mặc định bật nếu không set biến này).
SPRING_JPA_OPEN_IN_VIEW=false

# --- CORS ---
# Model deploy hiện tại là single-image (Spring Boot phục vụ luôn React static build -
# xem Dockerfile) nên FE/BE luôn CÙNG origin ở production -> biến này thực ra không
# cần thiết ở production (chỉ CORS request cross-origin mới bị trình duyệt chặn).
# Giữ nguyên giá trị mặc định (localhost dev) là vô hại; chỉ cần đổi nếu sau này FE
# được tách ra phục vụ từ 1 domain/CDN khác.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Seed tài khoản mặc định (admin/viewer) ---
# KHÔNG set SEED_DEFAULT_ACCOUNTS ở production/staging - để trống hoặc false.
# Chỉ bật tạm thời (true) cho LẦN ĐẦU bootstrap tài khoản admin đầu tiên trên một VPS
# mới, rồi tắt lại (false) và redeploy ngay sau khi đã đăng nhập đổi mật khẩu - xem
# checklist "First-Time VPS Setup" trong DEPLOYMENT & FLEET STRATEGY.md Section 5.4.
SEED_DEFAULT_ACCOUNTS=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=

# --- Feature flags (all false for Phase 1 — see ARCHITECTURE SPECIFICATION.md Section 4.3) ---
# LƯU Ý: tên biến PHẢI khớp đúng property Spring đọc thật
# (@Value("${features.ocop.enabled}") trong DynamicFlywayConfig.java) qua relaxed
# binding (dấu chấm -> gạch dưới, viết hoa) - tức FEATURES_OCOP_ENABLED, KHÔNG PHẢI
# ENABLE_OCOP. Bản .env mẫu trước đây trong DEPLOYMENT & FLEET STRATEGY.md dùng
# ENABLE_OCOP/ENABLE_SCIENCE/ENABLE_AGRICULTURE - đặt biến này sẽ KHÔNG có tác dụng gì
# (features.*.enabled vẫn giữ giá trị mặc định false trong code), vì Spring relaxed
# binding không tự "hiểu" ENABLE_OCOP tương ứng với features.ocop.enabled.
FEATURES_OCOP_ENABLED=false
FEATURES_SCIENCE_ENABLED=false
FEATURES_AGRICULTURE_ENABLED=false
