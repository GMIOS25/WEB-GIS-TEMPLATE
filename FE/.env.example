# Copy sang .env.local (Vite tu doc .env.local, khong commit len git) hoac .env:
#   cp .env.example .env.local

# URL goc cua BE API. Mac dinh trong code (axiosInstance.ts) da la
# http://localhost:8080 khi khong set bien nay, nen voi local dev thong thuong
# (BE chay port 8080 mac dinh) ban co the khong can tao file .env.local o day.
# Chi thuc su can khi BE chay o port/host khac, hoac khi build cho moi truong
# staging/production co domain API khac voi domain FE.
VITE_API_BASE_URL=http://localhost:8080

# Feature Flags (Giai doan 2 - Modular Extensions)
# Set to 'true' to enable the corresponding feature module in UI
VITE_ENABLE_OCOP=false
VITE_ENABLE_SCIENCE=false
VITE_ENABLE_AGRICULTURE=false

