spring.application.name=gis

# 1. Cấu hình kết nối PostgreSQL
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:your_database_name}
spring.datasource.username=${DB_USERNAME:your_database_username}
spring.datasource.password=${DB_PASSWORD:your_database_password}
spring.datasource.driver-class-name=org.postgresql.Driver

# 1b. Flyway: quản lý version schema thay cho việc import tay 4 file .sql trong data/
# baseline-on-migrate=true: cho phép Flyway "nhận" một DB đã có sẵn schema (trường hợp bạn
# đã từng chạy tay 4 file .sql cũ) mà không báo lỗi "schema not empty".
# baseline-version=4: DB hiện tại tương đương đã chạy xong V1->V4 (4 file .sql cũ),
# nên đánh dấu baseline ở version 4 để Flyway KHONG chay lai V1-V4 (se loi vi bang da ton tai).
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=4
spring.flyway.locations=classpath:db/migration/core

# 1c. Feature flags: bật/tắt module theo client (Giai đoạn 2 - multi-tenant)
features.science.enabled=false   
features.ocop.enabled=false
features.agriculture.enabled=false

# 2. Cấu hình JPA / Hibernate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ddl-auto: 
# - Chọn 'validate' để Hibernate chỉ kiểm tra xem các class Entity có khớp cấu trúc với DB hay không (Khuyên dùng vì bạn đã tạo schema thủ công qua các script trong data/).
# - Chọn 'none' nếu không muốn kiểm tra.
spring.jpa.hibernate.ddl-auto=validate

# open-in-view=false: tắt Open Session In View (Spring Boot mặc định BẬT nếu không
# khai báo dòng này). OSIV giữ Hibernate session mở suốt vòng đời request để lazy-load
# quan hệ (vd. Ward.province) ở bất kỳ đâu, kể cả ngoài transaction - tiện nhưng che
# giấu N+1 query và bị chính Spring Boot khuyến cáo tắt. Tắt ở đây bắt buộc phải fetch
# tường minh các quan hệ LAZY cần dùng (xem @EntityGraph trong WardRepository).
spring.jpa.open-in-view=false

# Lưu ý: Từ Hibernate 6 (Spring Boot 3.x), Hibernate tự động nhận diện tính năng Spatial 
# của PostgreSQL nên bạn không cần chỉ định cứng PostgisDialect nữa.

# 2b. Bật nén gzip cho response JSON (GeoJSON trả về rất lớn -> giảm mạnh thời gian tải)
server.compression.enabled=true
server.compression.mime-types=application/json,application/xml,text/html,text/plain,text/css,application/javascript
server.compression.min-response-size=1024

# 3. Cấu hình JWT
app.jwt.secret=${JWT_SECRET:your_jwt_secret_key_at_least_64_characters_long_for_security}
app.jwt.expiration-ms=86400000

# 3b. Cookie chứa JWT (HttpOnly) - thay cho việc FE lưu token ở localStorage.
# HttpOnly: JS không đọc được cookie này -> giảm rủi ro mất token toàn bộ nếu có XSS.
# cookie-secure: BẮT BUỘC true khi chạy production qua HTTPS (browser sẽ không gửi
# cookie Secure qua kết nối HTTP). Chỉ set false khi dev local qua HTTP thuần.
# cookie-same-site: "Strict" khi FE và BE cùng site (khuyến nghị, chống CSRF tốt nhất).
# Nếu FE/BE khác domain (khác site) ở production, dùng "None" (bắt buộc đi kèm Secure=true);
# "Lax" là phương án cân bằng khi cần đăng nhập từ link ngoài.
app.jwt.cookie-name=gis_token
app.jwt.cookie-secure=${JWT_COOKIE_SECURE:true}
app.jwt.cookie-same-site=${JWT_COOKIE_SAME_SITE:Strict}

# 4. CORS - danh sách origin (FE) được phép gọi API, phân tách bằng dấu phẩy.
# KHÔNG hardcode IP máy dev cá nhân/domain production vào code (SecurityConfig.java).
# Đổi máy dev hoặc mở rộng domain production chỉ cần đổi biến môi trường này,
# không cần sửa code + build lại.
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173}

# 4b. Tin tưởng header X-Forwarded-* do reverse proxy (Caddy - xem DEPLOYMENT & FLEET
# STRATEGY.md) gắn vào request. KHÔNG có dòng này, HttpServletRequest#getRemoteAddr()
# ở production sẽ luôn trả về IP của container Caddy (vì Caddy là process duy nhất
# gọi thẳng vào app container - "no published port on the host"), khiến MỌI request
# trông như đến từ cùng 1 IP. Hậu quả cụ thể: LoginAttemptService (rate-limit đăng
# nhập theo IP) sẽ gộp toàn bộ người dùng vào chung 1 "IP" - 1 người cố tình đăng
# nhập sai 5 lần có thể khoá đăng nhập của TẤT CẢ mọi người trong 15 phút. An toàn
# để luôn bật (không chỉ khi có proxy) vì kiến trúc deploy của dự án này đảm bảo app
# container không bao giờ bị lộ trực tiếp ra ngoài (chỉ Caddy được expose port 80/443).
server.forward-headers-strategy=framework

# 5. Seed tài khoản mặc định (admin/viewer) - CHỈ dùng cho dev/test local.
# Mặc định TẮT (an toàn theo mặc định): nếu không set gì, DatabaseSeeder sẽ
# KHÔNG chạy dù bảng users rỗng, kể cả ở production. Chỉ bật ở máy dev local
# bằng SEED_DEFAULT_ACCOUNTS=true và LUÔN cấp mật khẩu qua biến môi trường
# (>= 6 ký tự) - không có mật khẩu mặc định hardcode trong code.
app.seed.enabled=${SEED_DEFAULT_ACCOUNTS:false}
app.seed.admin-username=${SEED_ADMIN_USERNAME:admin}
app.seed.admin-password=${SEED_ADMIN_PASSWORD:}
app.seed.viewer-username=${SEED_VIEWER_USERNAME:viewer}
app.seed.viewer-password=${SEED_VIEWER_PASSWORD:}
